{
  "manifest_version": 3,
  "name": "Binance Remote Overlay",
  "version": "6.0.0",
  "description": "Remote managed dynamic overlay for Binance and custom domains",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
