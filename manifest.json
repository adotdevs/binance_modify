{
  "manifest_version": 3,
  "name": "Dynamic Multi-Domain Remote Overlay",
  "version": "6.0.0",
  "description": "Dynamic remote overlay and custom code injector managed via Next.js Admin Panel",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Remote Overlay Controller"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
